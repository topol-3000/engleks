# Nightly backup of both databases and .env (see engleks-backup). Installed by setup.sh;
# started by engleks-backup.timer, or by hand with `sudo systemctl start engleks-backup`.
[Unit]
Description=engleks nightly backup to the Storage Box
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
ExecStart=/usr/local/bin/engleks-backup
