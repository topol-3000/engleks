#!/usr/bin/env bash
# Nightly backup of engleks: dumps both databases, sends them and .env to the restic
# repository on the Storage Box, applies retention and reports to healthchecks.io.
#
# Installed as /usr/local/bin/engleks-backup by setup.sh and run as `deploy` by
# engleks-backup.service (engleks-backup.timer, 03:00 UTC). By hand:
# `sudo systemctl start engleks-backup`.
#
# Reads RESTIC_REPOSITORY, RESTIC_PASSWORD and HEALTHCHECKS_BACKUP_URL from .env; the
# password reaches restic only through its environment. The dumps are unencrypted, so the
# staging directory is emptied on every exit, success or not.
#
# ENGLEKS_DIR, BACKUP_DIR and ENGLEKS_LOCK_TIMEOUT exist for the tests.
set -euo pipefail

ENGLEKS_DIR=${ENGLEKS_DIR:-/opt/engleks}
BACKUP_DIR=${BACKUP_DIR:-/var/backups/engleks}
LOCK_TIMEOUT=${ENGLEKS_LOCK_TIMEOUT:-600}
ENV_FILE=$ENGLEKS_DIR/.env

umask 077

# Last KEY= line of .env, value verbatim. .env is never sourced.
env_get() {
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1
}

RESTIC_REPOSITORY=$(env_get RESTIC_REPOSITORY)
RESTIC_PASSWORD=$(env_get RESTIC_PASSWORD)
HC_URL=$(env_get HEALTHCHECKS_BACKUP_URL)
for name in RESTIC_REPOSITORY RESTIC_PASSWORD HC_URL; do
  if [[ -z ${!name} ]]; then
    echo "error: ${name/HC_URL/HEALTHCHECKS_BACKUP_URL} is not set in $ENV_FILE" >&2
    exit 1
  fi
done
export RESTIC_REPOSITORY RESTIC_PASSWORD

# A healthchecks.io outage must not fail the backup.
ping_hc() {
  curl -fsS -m 10 --retry 3 -o /dev/null "$HC_URL$1" || true
}

empty_staging() {
  find "${BACKUP_DIR:?}" -mindepth 1 -delete
}

# healthchecks.io's exit-status endpoint: /0 is success, anything else a failure.
finish() {
  local status=$?
  empty_staging || status=1
  ping_hc "/$status"
  exit "$status"
}
trap finish EXIT

ping_hc /start

exec 9>"$ENGLEKS_DIR/.deploy.lock"
if ! flock -w "$LOCK_TIMEOUT" 9; then
  echo "error: a deploy still holds the lock after ${LOCK_TIMEOUT}s" >&2
  exit 1
fi

cd "$ENGLEKS_DIR"
empty_staging

# Uncompressed, so restic can deduplicate and compress them. The single quotes leave the
# variables to the postgres container's shell.
echo "==> dump engleks"
docker compose exec -T postgres sh -c \
  'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --format=custom --compress=0' \
  >"$BACKUP_DIR/engleks.dump"
echo "==> dump litellm"
docker compose exec -T postgres sh -c \
  'pg_dump -U "$POSTGRES_USER" -d litellm --format=custom --compress=0' \
  >"$BACKUP_DIR/litellm.dump"

echo "==> restic backup"
restic backup "$BACKUP_DIR" "$ENV_FILE" --tag nightly --quiet
echo "==> restic forget"
restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune --quiet
echo "==> done"
