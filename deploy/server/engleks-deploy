#!/usr/bin/env bash
# Deploys one commit of engleks on the production server.
#
# Installed as /usr/local/bin/engleks-deploy by setup.sh and run as `deploy`, either as the
# forced command of CI's SSH key (the SHA arrives in SSH_ORIGINAL_COMMAND) or by hand:
# `engleks-deploy <sha>`. It lives outside the checkout, so a deploy never rewrites the
# script that is running it.
#
# Checks out the SHA and renders its .env (deploy/prod.env plus the secrets in Infisical,
# via engleks-render-env), then makes the server match it: restic must open the repository
# with the new values (a first deploy initialises it), a changed database password is set
# on its Postgres role, the GHCR images are pulled and started, and the API's LiteLLM key
# exists (a replaced key is deleted). If that fails, it deploys the previous SHA with the
# previous .env again and exits 1 anyway. A missing .env means a first deploy, with nothing
# to roll back to.
# Exit codes: 0 deployed, 1 failed (rolled back if possible) or lock timeout, 2 bad SHA.
#
# No secret reaches an argument list or the output: values travel on stdin or in a child's
# environment. .env.next (the rendered file) never outlives the script; .env.previous (the
# running .env, kept for the rollback) is deleted by a successful deploy and moved back over
# .env by the rollback.
#
# ENGLEKS_DIR and ENGLEKS_LOCK_TIMEOUT exist for the tests; the forced command gets no
# client environment, so in production they are always the defaults.
set -euo pipefail

ENGLEKS_DIR=${ENGLEKS_DIR:-/opt/engleks}
LOCK_TIMEOUT=${ENGLEKS_LOCK_TIMEOUT:-900}
ENV_FILE=$ENGLEKS_DIR/.env
NEXT_FILE=$ENV_FILE.next
PREVIOUS_FILE=$ENV_FILE.previous
IMAGE_PREFIX=ghcr.io/topol-3000/engleks-

umask 077

sha=${SSH_ORIGINAL_COMMAND-${1-}}
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: engleks-deploy <40-character lowercase commit SHA>" >&2
  exit 2
fi

# env_get FILE KEY: the last KEY= line of FILE, value verbatim; nothing if FILE does not
# exist. .env is never sourced.
env_get() {
  if [[ -f $1 ]]; then
    sed -n "s/^$2=//p" "$1" | tail -n 1
  fi
}

# changed OLD NEW: true if there was a value and it is not the new one.
changed() {
  [[ -n $1 && $1 != "$2" ]]
}

# check_restic FILE: restic must open the repository FILE names with the password FILE
# holds. Exit 10 (no repository there) means a first deploy or a moved repository.
check_restic() {
  local repository password rc=0
  repository=$(env_get "$1" RESTIC_REPOSITORY) || return 1
  password=$(env_get "$1" RESTIC_PASSWORD) || return 1
  echo "==> check the restic repository"
  RESTIC_REPOSITORY=$repository RESTIC_PASSWORD=$password restic cat config >/dev/null || rc=$?
  if [[ $rc -eq 10 ]]; then
    echo "==> initialise the restic repository"
    RESTIC_REPOSITORY=$repository RESTIC_PASSWORD=$password restic init || return 1
  elif [[ $rc -ne 0 ]]; then
    echo 'error: restic cannot open the repository with the new values; see "Changing a secret" in docs/deployment.md' >&2
    return 1
  fi
}

# alter_role ROLE PASSWORD: sets ROLE's password over Postgres' local socket. The value
# reaches psql as a variable on stdin (printf is a builtin, so it is in no argument list);
# the value rule forbids quotes and backslashes, so single-quoting it is safe.
alter_role() {
  echo "==> set the password of Postgres role $1"
  # shellcheck disable=SC2016 # $POSTGRES_USER and $POSTGRES_DB expand inside the container
  printf '%s\n' "\\set pw '$2'" "ALTER ROLE $1 PASSWORD :'pw';" |
    docker compose exec -T postgres sh -c 'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB"'
}

# generate_key KEY ARGS...: runs generate_key.py ARGS in the LiteLLM container, KEY on stdin.
generate_key() {
  local key=$1
  shift
  printf '%s' "$key" | docker compose exec -T litellm python /deploy/generate_key.py "$@"
}

# deploy SHA [offline]. set -e is off inside a function called from `if`, so every step
# ends in `|| return 1`. Online, it installs the .env it renders, after saving the running
# one as .env.previous. The rollback runs offline: it installs .env.previous if this run
# got as far as saving it, and needs no network, because the previous release's commit and
# images are already here and a GitHub, GHCR, Infisical or Storage Box outage may be why
# the deploy failed. (`up` still pulls an image that is missing.)
deploy() {
  local target=$1 offline=${2-} new_file="" key old_key="" old_api_db="" old_litellm_db=""
  local api_db litellm_db
  if [[ -z $offline ]]; then
    echo "==> fetch"
    git fetch origin || return 1
  fi
  echo "==> checkout $target"
  git checkout --detach "$target" || return 1

  if [[ -z $offline ]]; then
    echo "==> render .env"
    engleks-render-env "$target" "$NEXT_FILE" || return 1
    if [[ -f $ENV_FILE ]]; then
      install -m 600 "$ENV_FILE" "$PREVIOUS_FILE" || return 1
    fi
    new_file=$NEXT_FILE
  elif [[ -f $PREVIOUS_FILE ]]; then
    new_file=$PREVIOUS_FILE
  fi

  if [[ -n $new_file ]]; then
    # Before anything changes: a failure up to the move leaves the server as it was.
    # The rollback skips this; .env.previous's values were running.
    if [[ -z $offline ]] && {
      [[ ! -f $ENV_FILE ]] ||
        [[ $(env_get "$ENV_FILE" RESTIC_REPOSITORY) != "$(env_get "$new_file" RESTIC_REPOSITORY)" ]] ||
        [[ $(env_get "$ENV_FILE" RESTIC_PASSWORD) != "$(env_get "$new_file" RESTIC_PASSWORD)" ]]
    }; then
      check_restic "$new_file" || return 1
    fi

    old_api_db=$(env_get "$ENV_FILE" API_DB_PASSWORD) || return 1
    old_litellm_db=$(env_get "$ENV_FILE" LITELLM_DB_PASSWORD) || return 1
    old_key=$(env_get "$ENV_FILE" API_LLM_API_KEY) || return 1
    echo "==> install .env"
    mv -f "$new_file" "$ENV_FILE" || return 1

    # On a first deploy there is no old password: Postgres initialises with the new one.
    api_db=$(env_get "$ENV_FILE" API_DB_PASSWORD) || return 1
    litellm_db=$(env_get "$ENV_FILE" LITELLM_DB_PASSWORD) || return 1
    if changed "$old_api_db" "$api_db" || changed "$old_litellm_db" "$litellm_db"; then
      echo "==> start postgres"
      docker compose up -d --wait postgres || return 1
    fi
    if changed "$old_api_db" "$api_db"; then
      alter_role CURRENT_USER "$api_db" || return 1
    fi
    if changed "$old_litellm_db" "$litellm_db"; then
      alter_role litellm "$litellm_db" || return 1
    fi
  fi

  if [[ -z $offline ]]; then
    echo "==> pull images"
    docker compose pull || return 1
  fi
  # Checked on Compose 5.6: --wait returns 0 once the one-shot migrate has exited 0, so the
  # plain form works. A failing migrate fails `up`, because api waits for it to complete
  # successfully. 180 s covers LiteLLM's 90 s start period.
  echo "==> start"
  docker compose up -d --wait --wait-timeout 180 || return 1

  echo "==> ensure the API's LiteLLM key"
  key=$(env_get "$ENV_FILE" API_LLM_API_KEY) || return 1
  generate_key "$key" --ensure-stdin --max-budget 10 --budget-duration 30d || return 1
  if changed "$old_key" "$key"; then
    echo "==> delete the replaced LiteLLM key"
    generate_key "$old_key" --delete-stdin ||
      echo "warning: could not delete the replaced LiteLLM key; delete it by hand" >&2
  fi
}

# Removes local GHCR images of engleks other than the two given tags.
remove_old_images() {
  local keep=$1 previous=$2 image
  docker image ls --format '{{.Repository}}:{{.Tag}}' --filter "reference=${IMAGE_PREFIX}*" |
    while read -r image; do
      case $image in
        *":$keep" | *":<none>") continue ;;
      esac
      if [[ -n $previous && $image == *":$previous" ]]; then continue; fi
      echo "==> remove $image"
      docker image rm "$image" >/dev/null || echo "warning: could not remove $image" >&2
    done
}

cd "$ENGLEKS_DIR"

# If the SSH client goes away (the CI job is cancelled or times out, the network drops),
# writing to it would kill this script with SIGPIPE halfway through a deploy, before any
# rollback. So all output goes through tee, which with -p ignores the lost reader and keeps
# writing .deploy.log (the last deploy's output). On exit, wait for tee to drain.
exec > >(tee -p "$ENGLEKS_DIR/.deploy.log") 2>&1
tee_pid=$!
trap 'exec >&- 2>&-; wait "$tee_pid" || true' EXIT

exec 9>"$ENGLEKS_DIR/.deploy.lock"
if ! flock -w "$LOCK_TIMEOUT" 9; then
  echo "error: another deploy or backup still holds the lock after ${LOCK_TIMEOUT}s" >&2
  exit 1
fi

# Only now are .env.next and .env.previous this run's: a run that waited for the lock must
# not remove the running deploy's files. A .env.previous left by a killed run is not this
# run's to restore.
trap 'rm -f "$NEXT_FILE"; exec >&- 2>&-; wait "$tee_pid" || true' EXIT
rm -f "$PREVIOUS_FILE"

previous=$(env_get "$ENV_FILE" ENGLEKS_TAG)
echo "==> deploying $sha (running: ${previous:-none})"

if deploy "$sha"; then
  rm -f "$PREVIOUS_FILE"
  remove_old_images "$sha" "$previous" || echo "warning: image cleanup failed" >&2
  echo "==> deployed $sha"
  exit 0
fi

# Even a redeploy of the running SHA rolls back: it may have changed a secret.
echo "error: deploy of $sha failed" >&2
if [[ -n $previous ]]; then
  echo "==> rolling back to $previous"
  if deploy "$previous" offline; then
    echo "==> rolled back to $previous"
  else
    echo "error: rollback to $previous failed too; the server needs a person" >&2
  fi
fi
exit 1
