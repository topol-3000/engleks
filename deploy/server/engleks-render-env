#!/usr/bin/env bash
# Builds the production .env from deploy/prod.env (committed config), the secrets in
# Infisical and the SHA being deployed.
#
# Installed as /usr/local/bin/engleks-render-env by setup.sh and run as `deploy` in
# /opt/engleks with the checkout already at <sha>:  engleks-render-env <sha> <output>
# Exit codes: 0 written, 1 any failure (<output> is not touched).
#
# Secrets never reach a process's argument list: the login body and the Authorization
# header go to curl through process substitution, the client credentials reach jq through
# its environment. This script prints only step names, key names and counts.
#
# ENGLEKS_DIR and ENGLEKS_INFISICAL_CREDENTIALS exist for the tests; in production they are
# always the defaults.
set -euo pipefail

ENGLEKS_DIR=${ENGLEKS_DIR:-/opt/engleks}
CREDENTIALS=${ENGLEKS_INFISICAL_CREDENTIALS:-${HOME:?HOME is not set}/.config/engleks/infisical}
PROD_ENV=$ENGLEKS_DIR/deploy/prod.env
SECRETS_TXT=$ENGLEKS_DIR/deploy/secrets.txt
RESERVED=(ENGLEKS_TAG ENGLEKS_SECRETS_HASH)
NAME_RE='^[A-Za-z_][A-Za-z0-9_]*$'
HEADER='# Generated by engleks-render-env from deploy/prod.env and Infisical. Do not edit; changes are lost on the next deploy.'

umask 077
tmp=""
cleanup() {
  if [[ -n $tmp ]]; then rm -f "$tmp"; fi
}
trap cleanup EXIT

die() {
  echo "error: $*" >&2
  exit 1
}

if [[ $# -ne 2 ]]; then
  die "usage: engleks-render-env <40-character lowercase commit SHA> <output file>"
fi
sha=$1
output=$2
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  die "the SHA must be 40 lowercase hex characters"
fi

# Values go into .env unquoted, where Compose would interpolate $ and treat # and quotes
# specially, so those are refused rather than escaped. Names the key, never the value.
check_value() {
  if [[ $2 =~ [[:space:]\$\"\'\`\\#] ]]; then
    die "$1 must not contain whitespace, quotes, \$, # or backslashes"
  fi
}

check_not_reserved() {
  local reserved
  for reserved in "${RESERVED[@]}"; do
    if [[ $1 == "$reserved" ]]; then
      die "$1 is set by engleks-render-env; it must not be in $2"
    fi
  done
}

# Last KEY= line of the credential file, value verbatim. The file is never sourced.
cred_get() {
  sed -n "s/^$1=//p" "$CREDENTIALS" | tail -n 1
}

# --- deploy/prod.env: plain config, copied as it is --------------------------------------
echo "==> reading deploy/prod.env and deploy/secrets.txt"
if [[ ! -f $PROD_ENV ]]; then
  die "deploy/prod.env is missing: this commit predates it; it cannot be rendered"
fi
if [[ ! -f $SECRETS_TXT ]]; then
  die "deploy/secrets.txt is missing: this commit predates it; it cannot be rendered"
fi

declare -A seen=()
prod_lines=()
line=""
while IFS= read -r line || [[ -n $line ]]; do
  if [[ $line =~ ^[[:space:]]*(#|$) ]]; then continue; fi
  if [[ ! $line =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
    die "deploy/prod.env has a line that is not NAME=value (name: ${line%%=*})"
  fi
  name=${BASH_REMATCH[1]}
  check_not_reserved "$name" deploy/prod.env
  check_value "$name" "${BASH_REMATCH[2]}"
  if [[ -n ${seen[$name]-} ]]; then die "$name appears twice in deploy/prod.env"; fi
  seen[$name]=prod
  prod_lines+=("$line")
done <"$PROD_ENV"

# --- deploy/secrets.txt: names; the values come from Infisical ---------------------------
secret_names=()
while IFS= read -r line || [[ -n $line ]]; do
  line=${line%%#*}
  line=${line#"${line%%[![:space:]]*}"}
  line=${line%"${line##*[![:space:]]}"}
  if [[ -z $line ]]; then continue; fi
  if [[ ! $line =~ $NAME_RE ]]; then
    die "deploy/secrets.txt has an invalid name: $line"
  fi
  check_not_reserved "$line" deploy/secrets.txt
  if [[ ${seen[$line]-} == prod ]]; then die "$line is in both deploy/prod.env and deploy/secrets.txt"; fi
  if [[ ${seen[$line]-} == secret ]]; then die "$line appears twice in deploy/secrets.txt"; fi
  seen[$line]=secret
  secret_names+=("$line")
done <"$SECRETS_TXT"
echo "    ${#prod_lines[@]} config values, ${#secret_names[@]} secrets"

# --- Infisical credentials ---------------------------------------------------------------
if [[ ! -f $CREDENTIALS ]]; then
  die "the credential file $CREDENTIALS is missing (setup.sh writes it)"
fi
for field in INFISICAL_PROJECT_ID INFISICAL_ENVIRONMENT INFISICAL_CLIENT_ID INFISICAL_CLIENT_SECRET; do
  if [[ -z $(cred_get "$field") ]]; then
    die "$field is missing from the credential file $CREDENTIALS"
  fi
done
api_url=$(cred_get INFISICAL_API_URL)
api_url=${api_url:-https://eu.infisical.com}
api_url=${api_url%/}
project_id=$(cred_get INFISICAL_PROJECT_ID)
environment=$(cred_get INFISICAL_ENVIRONMENT)
client_id=$(cred_get INFISICAL_CLIENT_ID)
client_secret=$(cred_get INFISICAL_CLIENT_SECRET)
# These two go into a URL.
if [[ ! $project_id =~ ^[A-Za-z0-9._-]+$ ]]; then die "INFISICAL_PROJECT_ID has unexpected characters"; fi
if [[ ! $environment =~ ^[A-Za-z0-9._-]+$ ]]; then die "INFISICAL_ENVIRONMENT has unexpected characters"; fi
if [[ ! $api_url =~ ^https?://[^[:space:]]+$ ]]; then die "INFISICAL_API_URL is not a URL"; fi

login_body() {
  ID=$client_id SECRET=$client_secret jq -n '{clientId: env.ID, clientSecret: env.SECRET}'
}

# --- Infisical: login, then fetch --------------------------------------------------------
echo "==> logging in to Infisical"
if ! login=$(curl -fsS --max-time 30 -X POST -H 'Content-Type: application/json' \
  --data @<(login_body) "$api_url/api/v1/auth/universal-auth/login"); then
  die "the Infisical login failed"
fi
token=$(jq -r '.accessToken // empty' <<<"$login") || die "the Infisical login response is not JSON"
if [[ -z $token ]]; then die "the Infisical login response has no access token"; fi

echo "==> fetching the secrets of environment $environment"
if ! response=$(curl -fsS --max-time 30 -H @<(printf 'Authorization: Bearer %s\n' "$token") \
  "$api_url/api/v4/secrets?projectId=$project_id&environment=$environment&secretPath=/"); then
  die "fetching the secrets from Infisical failed"
fi
# @tsv writes a newline in a value as the two characters \n, which check_value rejects.
rows=$(jq -r '.secrets[] | [.secretKey, .secretValue] | @tsv' <<<"$response") \
  || die "the Infisical secrets response is not the expected JSON"

declare -A fetched=()
fetched_names=()
key=""
value=""
while IFS=$'\t' read -r key value; do
  if [[ -z $key ]]; then continue; fi
  fetched[$key]=$value
  fetched_names+=("$key")
done <<<"$rows"
echo "    ${#fetched_names[@]} secrets in Infisical"

# --- validate and build ------------------------------------------------------------------
secret_lines=""
for name in "${secret_names[@]}"; do
  if [[ ! -v fetched[$name] ]]; then die "$name is not in Infisical environment $environment"; fi
  if [[ -z ${fetched[$name]} ]]; then die "$name is empty in Infisical"; fi
  check_value "$name" "${fetched[$name]}"
  secret_lines+="$name=${fetched[$name]}"$'\n'
done

unknown=()
for name in "${fetched_names[@]}"; do
  if [[ ${seen[$name]-} != secret ]]; then unknown+=("$name"); fi
done
if [[ ${#unknown[@]} -gt 0 ]]; then
  echo "warning: ignoring ${#unknown[@]} Infisical keys not in deploy/secrets.txt: ${unknown[*]}" >&2
fi

hash=$(printf '%s' "$secret_lines" | sha256sum | cut -d ' ' -f 1)

# --- write atomically --------------------------------------------------------------------
echo "==> writing $output"
tmp=$(mktemp "$output.XXXXXX") || die "cannot create a temporary file next to $output"
{
  printf '%s\n' "$HEADER"
  if [[ ${#prod_lines[@]} -gt 0 ]]; then printf '%s\n' "${prod_lines[@]}"; fi
  printf '%s' "$secret_lines"
  printf 'ENGLEKS_TAG=%s\nENGLEKS_SECRETS_HASH=%s\n' "$sha" "$hash"
} >"$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$output"
tmp=""
echo "==> done"
