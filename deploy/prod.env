# Production configuration, committed and reviewed like code. engleks-render-env copies these
# lines into the server's .env on every deploy.
# Only plain values belong here. Secrets go to Infisical, and their names to deploy/secrets.txt.
# A name must not be in both files. Values: no whitespace, quotes, $, # or backslashes.
COMPOSE_FILE=compose.yaml:compose.prod.yaml
LLM_UPSTREAM_MODEL=openai/gpt-6.1-terra
LLM_UPSTREAM_API_BASE=https://api.openai.com/v1
API_LLM_MODEL=gpt-6.1-terra
API_BOT_USERNAME=Engleksbot
API_RATE_LIMIT_PER_MINUTE=10
API_DAILY_TOKEN_BUDGET=200000
LITELLM_UI_USERNAME=admin
RESTIC_REPOSITORY=sftp:storagebox:engleks
