# Copy to .env. One file serves both apps (API_* and BOT_* prefixes) and Compose.
# In containers, *_PASSWORD and *_TOKEN values are mounted as /run/secrets files.

# API
API_DB_HOST=localhost
API_DB_PORT=5432
API_DB_NAME=engleks
API_DB_USER=engleks
API_DB_PASSWORD=change-me
API_LOG_FORMAT=console
API_LOG_LEVEL=INFO
# Must equal BOT_SERVICE_TOKEN; in Compose both come from the service_token secret.
API_SERVICE_TOKEN=change-me
API_LLM_BASE_URL=http://localhost:4000/v1
API_LLM_MODEL=engleks-rewrite
API_LLM_API_KEY=replace-with-make-llm-key
API_LLM_TIMEOUT_S=60
# Per-user defaults; overridable per user with make admin a="user set-limits ..."
API_RATE_LIMIT_PER_MINUTE=10
API_DAILY_TOKEN_BUDGET=200000
# Optional: the bot's @username without @, so make invite prints a t.me deep link.
API_BOT_USERNAME=

# Bot
BOT_API_BASE_URL=http://localhost:8000
BOT_SERVICE_TOKEN=change-me
# Must exceed 2 × API_LLM_TIMEOUT_S: the API may call the LLM twice.
BOT_PROCESS_TIMEOUT_S=130
# Get a real token from @BotFather. Keep this placeholder unrealistic so secret scanners ignore it.
BOT_TELEGRAM_TOKEN=123456:replace-with-botfather-token
BOT_LOG_FORMAT=console
BOT_LOG_LEVEL=INFO

# LiteLLM proxy
# Starts ollama (dev profile). Leave unset in prod.
COMPOSE_PROFILES=dev
LLM_UPSTREAM_MODEL=ollama_chat/gemma3:4b
LLM_UPSTREAM_API_BASE=http://ollama:11434
# Prod example:
# LLM_UPSTREAM_MODEL=openai/gpt-6.1-terra
# LLM_UPSTREAM_API_BASE=https://api.openai.com/v1
# For engleks-rewrite in prod and the gpt-6.1-terra alias; any value works otherwise.
OPENAI_API_KEY=unused-in-dev
# Only for the claude-* aliases in deploy/litellm/config.yaml; any value works otherwise.
ANTHROPIC_API_KEY=unused-in-dev
# LiteLLM requires the sk- prefix.
LITELLM_MASTER_KEY=sk-change-me
# Letters and digits only: it goes into a URL.
LITELLM_DB_PASSWORD=changeme
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# Production only (unused in dev). The server's .env, written by
# deploy/server/bootstrap-env.sh, also has:
#   COMPOSE_FILE=compose.yaml:compose.prod.yaml   selects the GHCR image override
#   ENGLEKS_TAG=<commit sha>                      the deployed images; set by engleks-deploy
#   RESTIC_REPOSITORY, RESTIC_PASSWORD            nightly backups (engleks-backup)
#   HEALTHCHECKS_BACKUP_URL                       the backup check's ping URL (a secret)
# See docs/deployment.md.
