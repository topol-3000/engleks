# Copy to .env. One file serves both apps (API_* and BOT_* prefixes) and Compose.
# In containers, *_PASSWORD and *_TOKEN values are mounted as /run/secrets files.

# API
API_DB_HOST=localhost
API_DB_PORT=5432
API_DB_NAME=engleks
API_DB_USER=engleks
API_DB_PASSWORD=change-me
API_LOG_FORMAT=console
API_LOG_LEVEL=INFO

# Bot
BOT_API_BASE_URL=http://localhost:8000
BOT_SERVICE_TOKEN=change-me
# Get a real token from @BotFather. Keep this placeholder unrealistic so secret scanners ignore it.
BOT_TELEGRAM_TOKEN=123456:replace-with-botfather-token
BOT_LOG_FORMAT=console
BOT_LOG_LEVEL=INFO
